<Window x:Class="Channel.Admin.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Понятный .NET — управление каналом" Width="1280" Height="850" MinWidth="1060" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#F3F5FA" FontFamily="Segoe UI" Foreground="#17243D">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#243552"/><Setter Property="BorderBrush" Value="#DCE2ED"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="16,10"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10"/><Setter Property="BorderBrush" Value="#DCE2ED"/><Setter Property="Background" Value="White"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="18,13"/><Setter Property="Margin" Value="0,0,12,0"/><Setter Property="BorderBrush" Value="#E3E8F1"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#6D7B92"/><Setter Property="FontSize" Value="12"/></Style>
 </Window.Resources>
 <Grid Background="#F3F5FA">
  <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#132039" Padding="22,28">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <Border Background="#405FF2" CornerRadius="12" Width="48" Height="48" HorizontalAlignment="Left"><TextBlock Text=".N" Foreground="White" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <TextBlock Text="Понятный .NET" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,5"/>
     <TextBlock Text="Управление каналом" Foreground="#9EAECC" FontSize="12"/>
     <Border Background="#263856" CornerRadius="7" Padding="12" Margin="0,35,0,18"><TextBlock Text="●  Обзор и публикации" Foreground="White" FontSize="13"/></Border>
     <Button Content="Открыть канал ↗" Click="OpenChannel" Background="#20314E" Foreground="White" BorderBrush="#344561" Margin="0,0,0,10"/>
     <Button Content="Бот-редактор ↗" Click="OpenBot" Background="#20314E" Foreground="White" BorderBrush="#344561" Margin="0,0,0,10"/>
     <Button Content="Папка проекта" Click="OpenProject" Background="#20314E" Foreground="White" BorderBrush="#344561" Margin="0,0,0,10"/>
    </StackPanel>
    <StackPanel VerticalAlignment="Bottom"><TextBlock Text="ЛОКАЛЬНЫЙ СЕРВИС" Foreground="#8497BA" FontSize="10" FontWeight="Bold"/><TextBlock Text="Работает, пока компьютер&#10;включён и подключён к сети." Foreground="#9EAECC" TextWrapping="Wrap" Margin="0,8,0,8" FontSize="12"/><TextBlock Text="Время: Киев · лимит: UTC" Foreground="#8497BA" FontSize="11"/></StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="26,22,24,14">
   <Grid.RowDefinitions><RowDefinition Height="65"/><RowDefinition Height="Auto"/><RowDefinition Height="120"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
   <DockPanel><StackPanel><TextBlock Text="Панель управления" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="ChannelSummary" Text="Подключение к локальным данным…" Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><Button Content="↻  Обновить" Click="RefreshClick" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0"/></DockPanel>
   <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,15">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><StackPanel Orientation="Horizontal"><Ellipse x:Name="StateDot" Fill="#94A3B8" Width="10" Height="10" Margin="0,0,10,0"/><TextBlock x:Name="ServiceTitle" Text="Проверяем сервис…" FontSize="18" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="ServiceDetails" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="20,7,16,0"/><TextBlock x:Name="SourceHealth" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="20,4,16,0"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="StartButton" Content="▶  Запустить" Click="StartClick" Background="#405FF2" Foreground="White" BorderBrush="#405FF2"/><Button x:Name="StopButton" Content="■  Остановить" Click="StopClick" Foreground="#B53C50"/><Button x:Name="RestartButton" Content="Перезапуск" Click="RestartClick" Margin="0"/></StackPanel>
    </Grid>
   </Border>
   <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,16">
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Опубликовано" Style="{StaticResource Muted}"/><TextBlock x:Name="PublishedCount" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,2"/><TextBlock Text="за всё время" Style="{StaticResource Muted}" FontSize="10"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="В работе и очереди" Style="{StaticResource Muted}"/><TextBlock x:Name="QueueCount" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,2"/><TextBlock x:Name="ReviewCount" Text="на согласовании: —" Style="{StaticResource Muted}" FontSize="10"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Требуют внимания" Style="{StaticResource Muted}"/><TextBlock x:Name="IssueCount" Text="—" FontSize="28" FontWeight="SemiBold" Foreground="#C1495D" Margin="0,2"/><TextBlock Text="ошибки и неясные отправки" Style="{StaticResource Muted}" FontSize="10"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0"><StackPanel><TextBlock Text="Обращения к ИИ" Style="{StaticResource Muted}"/><TextBlock x:Name="AiUsage" Text="— / —" FontSize="28" FontWeight="SemiBold" Margin="0,2"/><TextBlock Text="сегодня · сутки UTC" Style="{StaticResource Muted}" FontSize="10"/></StackPanel></Border>
   </UniformGrid>
   <TabControl Grid.Row="3" Background="White" BorderBrush="#DCE2ED">
    <TabItem Header="Публикации"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><TextBlock Text="Поиск" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="SearchBox" Width="210" TextChanged="FilterChanged" HorizontalAlignment="Left"/><ComboBox x:Name="StateFilter" Width="180" Margin="12,0,0,0" SelectionChanged="FilterChanged" SelectedIndex="0"><ComboBoxItem Content="Все публикации"/><ComboBoxItem Content="В очереди и работе"/><ComboBoxItem Content="Опубликованные"/><ComboBoxItem Content="Требуют внимания"/><ComboBoxItem Content="Пропущенные"/></ComboBox></StackPanel>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="4*"/></Grid.ColumnDefinitions>
      <DataGrid x:Name="PostsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="PostSelected" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="#E3E8F1" RowHeaderWidth="0" RowHeight="42" Background="White" AlternatingRowBackground="#F7F9FC" HorizontalGridLinesBrush="#EDF0F5"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/><DataGridTextColumn Header="Состояние" Binding="{Binding Status}" Width="135"/><DataGridTextColumn Header="Тема" Binding="{Binding Title}" Width="*"/></DataGrid.Columns></DataGrid>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Button Content="Источник ↗" Click="OpenSource" Padding="10,6"/><Button Content="Публикация ↗" Click="OpenPublication" Padding="10,6"/></StackPanel><TabControl Grid.Row="1" BorderBrush="#E3E8F1"><TabItem Header="Результат"><TextBox x:Name="DraftText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Text="Выберите публикацию слева."/></TabItem><TabItem Header="Оригинал"><TextBox x:Name="OriginalText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0"/></TabItem><TabItem Header="Проверка"><TextBox x:Name="NotesText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0"/></TabItem></TabControl></Grid>
     </Grid>
    </Grid></TabItem>
    <TabItem Header="Канал и настройки"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22"><TextBlock Text="Подключение и режим работы" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="ConfigurationText" FontSize="14" TextWrapping="Wrap" LineHeight="25" Margin="0,12,0,16"/><StackPanel Orientation="Horizontal"><Button Content="Обновить данные Telegram" Click="TelegramRefresh"/><Button Content="Правила переработки" Click="OpenPrompt"/></StackPanel><TextBlock x:Name="TelegramInfo" Text="Данные Telegram ещё не запрошены." TextWrapping="Wrap" FontSize="14" Margin="0,16,0,12"/><TextBlock Text="При автопубликации новые подходящие посты отправляются сразу. Закрытие админки не останавливает сервис. Ключи и токены в интерфейсе не отображаются." Style="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Журнал работы"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,8"><TextBlock Text="Последние записи stdout, stderr и ошибок запуска" Style="{StaticResource Muted}" VerticalAlignment="Center"/><Button Content="Папка журналов" Click="OpenLogs" HorizontalAlignment="Right" Padding="10,6"/></DockPanel><TextBox Grid.Row="1" x:Name="LogText" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></Grid></TabItem>
   </TabControl>
   <TextBlock Grid.Row="4" x:Name="Footer" VerticalAlignment="Bottom" Foreground="#6D7B92" FontSize="11" TextTrimming="CharacterEllipsis"/>
  </Grid>
 </Grid>
</Window>
